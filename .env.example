# Copie para .env e ajuste

# Senhas de cada pessoa (troque!)
PASSWORD_CARLOS=carta123
PASSWORD_AMIGA=carta456

# Segredo usado para assinar o token de sessão (use algo longo e aleatório)
SESSION_SECRET=euamoBrasil

# Janela de entrega aleatória, em horas (padrão: 24 a 72 = 1 a 3 dias)
# Para testar rápido: MIN_HOURS=0.02 e MAX_HOURS=0.05 (1 a 3 minutos)
MIN_HOURS=0.02
MAX_HOURS=0.05

# Onde guardar o banco SQLite (em hospedagem, aponte para um disco persistente)
# DB_PATH=/data/slowmail.db

PORT=3000
